# Copy to caremate-secrets.env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# Local database; use the approved managed database URL for deployed environments.
TURSO_DATABASE_URL=file:caremate-local.db
TURSO_AUTH_TOKEN=

# Production values must be unique random secrets of at least 32 characters.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
PHONE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
PHONE_LOOKUP_PEPPER=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
OTP_HASH_PEPPER=replace-with-at-least-32-random-characters

# Development authentication. No production SMS integration is implied.
LOGIN_OTP_DEVELOPMENT_CODE=123456

# Prescription providers are disabled safely until explicitly configured.
PRESCRIPTION_CLOUD_OCR_ENABLED=false
PRESCRIPTION_AI_ENABLED=false
PRESCRIPTION_OCR_PROVIDER=disabled
PRESCRIPTION_AI_EXTRACTOR=disabled
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_DOCUMENT_AI_LOCATION=asia-south1
OPENAI_API_KEY=
OPENAI_PRESCRIPTION_MODEL=gpt-5.6-sol
