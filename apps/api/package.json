{
  "name": "@caremate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migration:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/documentai": "^10.0.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.3",
    "jose": "6.1.0",
    "openai": "^7.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "prisma": "7.9.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
