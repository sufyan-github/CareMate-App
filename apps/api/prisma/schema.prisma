generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model PlatformMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id                       String            @id
  phoneE164Encrypted       String
  phoneLookupHash          String            @unique
  status                   String            @default("ACTIVE")
  locale                   String            @default("bn-BD")
  tokenVersion             Int               @default(0)
  showMedicineOnLockScreen Boolean           @default(false)
  allowAnalytics           Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deletedAt                DateTime?
  deletionRequestedAt      DateTime?
  sessions                 AuthSession[]
  patientProfiles          PatientProfile[]
  careInvitationsSent      CareInvitation[]  @relation("CareInvitationInviter")
  careInvitationsAccepted  CareInvitation[]  @relation("CareInvitationAcceptor")
  careAccessAuditEvents    CareAccessAudit[]
}

model OtpChallenge {
  id                   String    @id
  phoneE164Encrypted   String
  phoneLookupHash      String
  purpose              String
  locale               String
  deviceInstallationId String
  requestIpHash        String    @default("")
  codeHash             String
  deliveryReference    String?
  attempts             Int       @default(0)
  maxAttempts          Int       @default(5)
  expiresAt            DateTime
  resendAvailableAt    DateTime
  consumedAt           DateTime?
  invalidatedAt        DateTime?
  createdAt            DateTime  @default(now())

  @@index([phoneLookupHash, createdAt])
  @@index([deviceInstallationId, createdAt])
  @@index([requestIpHash, createdAt])
}

model AuthSession {
  id                 String              @id
  userId             String
  installationId     String
  platform           String
  appVersion         String
  deviceName         String
  tokenFamilyId      String              @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  reuseDetectedAt    DateTime?
  createdAt          DateTime            @default(now())
  lastSeenAt         DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id])
  refreshCredentials RefreshCredential[]

  @@index([userId, revokedAt])
}

model RefreshCredential {
  id           String      @id
  sessionId    String
  tokenHash    String      @unique
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime    @default(now())
  session      AuthSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, revokedAt])
}

model PatientProfile {
  id              String           @id
  ownerUserId     String           @unique
  displayName     String
  timezone        String
  status          String           @default("ACTIVE")
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  owner           User             @relation(fields: [ownerUserId], references: [id])
  medications     Medication[]
  ocrDrafts       OcrDraft[]
  careInvitations CareInvitation[]
  doseOccurrences DoseOccurrence[]
}

model CareInvitation {
  id                    String            @id
  patientProfileId      String
  inviterUserId         String
  inviteePhoneEncrypted String
  inviteePhoneHash      String
  permissionsJson       String
  status                String            @default("PENDING")
  deliveryStatus        String            @default("IN_APP_PENDING")
  acceptedByUserId      String?
  expiresAt             DateTime
  acceptedAt            DateTime?
  declinedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  patientProfile        PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  inviter               User              @relation("CareInvitationInviter", fields: [inviterUserId], references: [id])
  acceptedBy            User?             @relation("CareInvitationAcceptor", fields: [acceptedByUserId], references: [id])
  auditEvents           CareAccessAudit[]

  @@index([patientProfileId, status])
  @@index([inviteePhoneHash, status, expiresAt])
}

model CareAccessAudit {
  id           String         @id
  invitationId String
  actorUserId  String
  action       String
  createdAt    DateTime       @default(now())
  invitation   CareInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  actor        User           @relation(fields: [actorUserId], references: [id])

  @@index([invitationId, createdAt])
  @@index([actorUserId, createdAt])
}

model OcrDraft {
  id               String         @id
  patientProfileId String
  status           String         @default("REVIEW_REQUIRED")
  documentType     String
  language         String
  rawText          String
  medicinesJson    String
  warningsJson     String
  provider         String
  providerModel    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([patientProfileId, createdAt])
}

model Medication {
  id               String           @id
  patientProfileId String
  displayName      String
  normalizedName   String?
  strengthValue    Float?
  strengthUnit     String?
  form             String
  notes            String?
  status           String           @default("ACTIVE")
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  patientProfile   PatientProfile   @relation(fields: [patientProfileId], references: [id])
  instructions     DoseInstruction?
  schedules        MedicationSchedule[]
  doseOccurrences  DoseOccurrence[]

  @@index([patientProfileId, status])
}

model DoseInstruction {
  id            String     @id
  medicationId  String     @unique
  quantityValue Float
  quantityUnit  String
  route         String
  mealRelation  String
  sourceText    String?
  medication    Medication @relation(fields: [medicationId], references: [id])
}

model MedicationSchedule {
  id             String           @id
  medicationId   String
  status         String           @default("ACTIVE")
  timezone       String
  startDate      String
  endDate        String?
  timesJson      String
  recurrence     String           @default("DAILY")
  daysOfWeekJson String           @default("[]")
  excludedDatesJson String        @default("[]")
  generationHorizonDays Int       @default(30)
  generatedThroughDate String
  timezonePolicy String           @default("LOCAL_TIME_ANCHORED")
  revision       Int              @default(1)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  medication     Medication       @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  occurrences    DoseOccurrence[]

  @@index([medicationId, status])
}

model DoseOccurrence {
  id                       String             @id
  scheduleId               String
  medicationId             String
  patientProfileId         String
  ruleRevision             Int
  plannedLocalDateTime     String
  plannedAt                DateTime
  timezone                 String
  quantityValue            Float
  quantityUnit             String
  status                   String             @default("SCHEDULED")
  version                  Int                @default(1)
  reminderSentAt           DateTime?
  snoozedUntil             DateTime?
  responseDueAt            DateTime?
  snoozeCount              Int                @default(0)
  missedAt                 DateTime?
  confirmedAt              DateTime?
  timingClassification     String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  schedule                 MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  medication               Medication         @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  patientProfile           PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  events                   DoseEvent[]
  confirmation             DoseConfirmation?

  @@unique([scheduleId, plannedLocalDateTime, ruleRevision])
  @@index([patientProfileId, plannedAt])
  @@index([scheduleId, status])
}

model DoseEvent {
  id               String         @id
  occurrenceId     String
  eventType         String
  sequence          Int
  actorUserId       String?
  clientMutationId String?        @unique
  clientAt         DateTime?
  serverAt         DateTime       @default(now())
  metadataJson     String         @default("{}")
  resultJson       String?
  occurrence       DoseOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  @@index([occurrenceId, serverAt])
  @@unique([occurrenceId, sequence])
}

model DoseConfirmation {
  id                   String         @id
  occurrenceId         String         @unique
  actorUserId           String
  authSessionId         String
  deviceInstallationId String
  timingClassification String
  confirmedAt          DateTime
  clientAt              DateTime
  occurrence            DoseOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
}
