# API runtime
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# Local development and automated tests use a file URL.
# Production/staging use the provided libsql:// Turso URL.
TURSO_DATABASE_URL=file:./prisma/caremate-dev.db
TURSO_AUTH_TOKEN=

# Session signing keys must be generated per environment.
ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_bytes
REFRESH_TOKEN_PEPPER=replace_with_at_least_32_random_bytes
OTP_HASH_PEPPER=replace_with_at_least_32_random_bytes
PHONE_LOOKUP_PEPPER=replace_with_at_least_32_random_bytes
PHONE_ENCRYPTION_KEY=replace_with_at_least_32_random_bytes

# Login OTP defaults to an explicitly labelled development Adapter.
LOGIN_OTP_PROVIDER=development
LOGIN_OTP_DEVELOPMENT_CODE=123456
OTP_RESEND_COOLDOWN_SECONDS=60

# bdapps subscription gateway (never used as CareMate login OTP).
BDAPPS_GATEWAY_BASE_URL=http://localhost:8081
BDAPPS_INTERNAL_API_KEY=replace_with_a_64_character_random_hex_secret
